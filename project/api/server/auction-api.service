[Unit]
Description=Auction API (uvicorn)
After=network.target

[Service]
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/auction-server

# 로그를 기존 파이프라인과 동일하게 파일로 남김
ExecStart=/usr/bin/bash -lc "exec /home/ec2-user/auction-server/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 2 >> /home/ec2-user/auction-server/logs/api.log 2>&1"

# 비정상 종료 시 자동 재기동
Restart=always
RestartSec=2

# 메모리 한도 (초과 시 종료 → 재기동)
MemoryMax=1500M
OOMPolicy=kill

# (옵션) 파일 핸들/태스크 상한
LimitNOFILE=65535
TasksMax=512

Environment=ENV=prod

[Install]
WantedBy=multi-user.target